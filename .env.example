# Copy to .env and fill in. .env is gitignored — never commit it.

# --- Bitget DEMO key (read/write, NO withdraw permission, bind an IP) ---
# Created in Demo mode: Personal Center -> API Key Management -> Demo API Key.
# The client always sends `paptrading: 1`; there is no code path to the live venue.
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_API_PASSPHRASE=

# --- LLM ---
ANTHROPIC_API_KEY=
# Qwen through the Bitget hackathon gateway (used when [llm] provider = "qwen").
QWEN_API_KEY=

# --- Safety gate: separate from credentials, defaults to OFF ---
# 0 / unset -> dry-run: full loop runs, orders are logged as "would_submit", nothing is sent.
# 1         -> orders are submitted to the Bitget DEMO environment.
ENABLE_TRADING=0

# --- Log publishing ---
# Commit logs/ to git as they accrue (commit only touches logs/).
AUTO_COMMIT_LOG=0
# Also `git push` after each log commit (needs a remote configured).
AUTO_PUSH=0
